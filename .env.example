# Optional default/fallback for white label installs — each admin can instead set this directly
# in the curation panel (Configuração da integração), which takes priority over these env vars.
# Must match exactly an "Authorized redirect URI" registered for the app in the ML DevCenter.
# Leave empty to default to https://${APP_DOMAIN}/oauth/ml/callback.
ML_REDIRECT_URI=
ML_AFFILIATE_PARAMS=
ML_SITE_ID=MLB
ML_DISCOVERY_CATEGORIES=MLB1574,MLB1246,MLB1000,MLB1648
ML_VERIFY_INTERVAL_HOURS=6
# Required to encrypt Telegram and WhatsApp provider credentials at rest.
# Define a stable secret in production. If blank, the application stores a generated key in MariaDB.
INTEGRATION_SECRET_KEY=
